{
  "name": "myholypoly",
  "version": "0.1.11",
  "private": true,
  "author": "magune-lab",
  "license": "MIT",
  "description": "A Windows companion for e-POLY homework planning.",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "package:win": "electron-packager . myholypoly --platform=win32 --arch=x64 --out=release --overwrite --icon=assets/myholypoly.ico --ignore=release",
    "package:msix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-msix.ps1"
  },
  "build": {
    "appId": "com.magune-lab.myholypoly",
    "productName": "myholypoly",
    "directories": {
      "output": "release-msix"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "PRIVACY.md",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "win": {
      "icon": "assets/myholypoly.ico",
      "target": "appx"
    },
    "appx": {
      "applicationId": "myholypoly",
      "identityName": "magune-lab.myholypoly",
      "publisher": "CN=magune-lab",
      "publisherDisplayName": "magune-lab",
      "displayName": "myholypoly",
      "artifactName": "myholypoly-windows-x64-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
